    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@vue/test-utils": "^2.5.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.14.0",
